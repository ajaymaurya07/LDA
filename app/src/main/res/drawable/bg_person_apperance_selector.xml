<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/gray" /> <!-- Soft teal for clickable effect -->
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#ffffff" /> <!-- Light gray default background -->
            <corners android:radius="0dp" />
        </shape>
    </item>
</selector>