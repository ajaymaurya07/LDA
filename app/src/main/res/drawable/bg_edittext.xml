<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#fceee2"> <!-- ripple color -->

    <!-- 👇 Your original shape background -->
    <item>
        <shape android:shape="rectangle">
            <!-- Background color -->
            <solid android:color="@android:color/white" />

            <!-- Border -->
            <stroke
                android:width="1dp"
                android:color="@color/gray" />

            <!-- Rounded corners -->
            <corners android:radius="10dp" />

            <!-- Padding inside -->
            <padding
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp" />
        </shape>
    </item>

</ripple>
