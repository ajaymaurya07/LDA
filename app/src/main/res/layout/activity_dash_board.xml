<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#F5F6FA"
    android:id="@+id/root">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:padding="20dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Citizen Dashboard"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

    </LinearLayout>

    <!-- Welcome Text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:text="Welcome"
        android:textSize="14sp"
        android:textColor="#7A7A7A" />

    <!-- Pay & Track Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:text="Pay Track"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"/>

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:text="Pay your bills instantly."
            android:layout_marginTop="3dp"
            android:textColor="#6D6D6D"
            android:textSize="13sp"/>

        <!-- Payment Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <!-- Quick Payment -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:padding="15dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="12dp"
                android:backgroundTint="#F4B400"
                android:clipToOutline="true"
                android:background="@drawable/card_rounded">

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/rupee_icon"
                    app:tint="#FFFFFF"/>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:text="Quick Payment"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Track Application -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:padding="15dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="12dp"
                android:background="@drawable/card_rounded_blue">

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/track_icon"
                    app:tint="#FFFFFF"/>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:text="Track Application"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Services Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:text="Quick Services"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:textSize="18sp"
        android:textColor="#000000"/>

    <!-- Services Grid -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="16dp"
            android:rowCount="5">

            <!-- Service Cards -->
            <include layout="@layout/item_service_card"/>

        </GridLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <include layout="@layout/bottom_navbar"/>

</LinearLayout>
