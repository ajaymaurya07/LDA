<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= ZONE ================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zone"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilZone"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etZone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Zone"
                android:text="Zone1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ================= WARD ================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Corporate Ward"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilWard"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Ward"
                android:text="Ward2"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ================= MOHALLA ================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mohalla"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMohalla"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMohalla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Mohalla"
                android:text="Mohalla3"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ================= CHK NO ================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chk No"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilChuck"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChuck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Chk No"
                android:text="chk5"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ================= HOUSE NO ================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="House No"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHouse"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHouse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter House No"
                android:inputType="text"
                android:text="52"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ================= SEARCH BUTTON ================= -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearchMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Search"
            android:textAllCaps="false"
            android:padding="14dp"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp"/>

    </LinearLayout>

</ScrollView>
