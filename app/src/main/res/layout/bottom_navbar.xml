<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="#FFFFFF"
    android:gravity="center"
    android:elevation="8dp">

    <!-- Home -->
    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/iconHome"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/home_icon"
            app:tint="#9E9E9E"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/txtHome"
            android:text="Home"
            android:textSize="12sp"
            android:textColor="#1E4CC7"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Dashboard -->
    <LinearLayout
        android:id="@+id/navDashboard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/iconDashboard"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/dashboard_icon"
            app:tint="#9E9E9E"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/txtDashboard"
            android:text="My Dashboard"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Transactions -->
    <LinearLayout
        android:id="@+id/navTransactions"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/iconTransactions"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/transaction_icon"
            app:tint="#9E9E9E"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/txtTransactions"
            android:text="My Transactions"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Account -->
    <LinearLayout
        android:id="@+id/navAccount"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/iconAccount"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/account_icon"
            app:tint="#9E9E9E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/txtAccount"
            android:text="Account"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

</LinearLayout>
