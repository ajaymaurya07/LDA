                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:fontFamily="@font/montserrat_regular" />

            </LinearLayout>

<!--            Officer in charge-->
            <LinearLayout
                android:id="@+id/officer_in_charge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_person_apperance_selector">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Officer in charge"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:fontFamily="@font/montserrat_regular" />

            </LinearLayout>

<!--            Principal secretary-->
            <LinearLayout
                android:id="@+id/principal_secretary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_person_apperance_selector">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Principal secretary"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:fontFamily="@font/montserrat_regular" />

            </LinearLayout>

<!--            Secretary-->
            <LinearLayout
                android:id="@+id/Secretary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_person_apperance_selector">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Secretary"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:fontFamily="@font/montserrat_regular" />

            </LinearLayout>

<!--            Sub divisional officer-->
            <LinearLayout
                android:id="@+id/sub_divisional_officer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_person_apperance_selector">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sub divisional officer"
