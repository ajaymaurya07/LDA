<?xml version="1.0" encoding="utf-8"?>
<layout>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".eCourtUi.viewAllActivity.ViewAllRecentInterimOrderActivity">


    <include
        layout="@layout/navbar_activity"
        android:id="@+id/see_all_interim_order_navbar"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:cardUseCompatPadding="true"
        android:layout_marginBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Title and Filter Dropdown -->

            <LinearLayout
                android:id="@+id/additional_commissioner_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_person_apperance_selector">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Additional Commissioner"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:fontFamily="@font/montserrat_regular" />

            </LinearLayout>
            <LinearLayout
                android:id="@+id/additional_secretary_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_person_apperance_selector">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Additional Secretary"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:fontFamily="@font/montserrat_regular" />

            </LinearLayout>
            <LinearLayout
                android:id="@+id/addirional_committee_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_person_apperance_selector">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Administrative Committee"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:fontFamily="@font/montserrat_regular" />

            </LinearLayout>

<!--            Assistant engineer-->
            <LinearLayout
                android:id="@+id/assistant_engineer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_person_apperance_selector">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Assistant engineer"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:fontFamily="@font/montserrat_regular" />

            </LinearLayout>

<!--            Chief accounts officer-->
            <LinearLayout
                android:id="@+id/chief_accounts_officer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_person_apperance_selector">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chief accounts officer"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:fontFamily="@font/montserrat_regular" />

            </LinearLayout>

<!--            Chief engineer-->
            <LinearLayout
                android:id="@+id/chief_engineer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_person_apperance_selector">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chief engineer"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:fontFamily="@font/montserrat_regular" />

            </LinearLayout>

<!--            Chief secretary-->
            <LinearLayout
                android:id="@+id/chief_secretary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_person_apperance_selector">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chief secretary"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:fontFamily="@font/montserrat_regular" />

            </LinearLayout>

<!--            Commissioner-->
            <LinearLayout
                android:id="@+id/commissioner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_person_apperance_selector">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Commissioner"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:fontFamily="@font/montserrat_regular" />

            </LinearLayout>

<!--            Director-->
            <LinearLayout
                android:id="@+id/Director"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
