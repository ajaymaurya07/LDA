<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E8ECEF"
    app:strokeWidth="1dp"
    app:rippleColor="@color/material_on_surface_emphasis_medium"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingVertical="16dp"
        android:orientation="vertical"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/cnr_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="@color/material_on_surface_emphasis_medium" />


        <TextView
            android:id="@+id/registration_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="@color/material_on_surface_emphasis_medium" />

        <TextView
            android:id="@+id/designation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="@color/material_on_surface_emphasis_medium" />


        <TextView
            android:visibility="gone"
            android:id="@+id/petitioner_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:maxLines="2"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="@color/material_on_surface_emphasis_medium" />


        <TextView
            android:visibility="gone"
            android:id="@+id/respondent_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:maxLines="2"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="@color/material_on_surface_emphasis_medium" />


        <TextView
            android:id="@+id/case_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_regular"
            android:maxLines="2"
            android:textColor="@color/material_on_surface_emphasis_medium" />

        <TextView
            android:id="@+id/court_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_regular"
            android:maxLines="2"
            android:textColor="@color/material_on_surface_emphasis_medium" />

        <TextView
            android:id="@+id/bench_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_regular"
            android:maxLines="2"
            android:textColor="@color/material_on_surface_emphasis_medium" />


        <TextView
            android:id="@+id/classification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_regular"
            android:maxLines="2"
            android:textColor="@color/material_on_surface_emphasis_medium" />



    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
