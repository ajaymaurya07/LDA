<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header Row (Grievance ID + Status Badge) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvGId"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="GRV-2024-00987"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#000"/>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/status_pending_bg"/>
        </LinearLayout>

        <!-- Date + Time -->
        <TextView
            android:id="@+id/tvDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submitted: 10 Dec 2024 • 03:45 PM"
            android:textSize="13sp"
            android:textColor="#666"
            android:layout_marginTop="4dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#E0E0E0" />

        <!-- Zone -->
        <TextView
            android:id="@+id/tvZone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zone: Zone 3"
            android:textSize="14sp"
            android:textColor="#444"/>

        <!-- Ward -->
        <TextView
            android:id="@+id/tvWard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ward: Ward 12"
            android:textSize="14sp"
            android:textColor="#444"/>

        <!-- Category -->
        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category: Property Tax Correction"
            android:textSize="14sp"
            android:textColor="#444"/>

        <!-- Name -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name: Rahul Sharma"
            android:textSize="14sp"
            android:textColor="#444"/>

        <!-- Mobile -->
        <TextView
            android:id="@+id/tvMobile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mobile: 9876543210"
            android:textSize="14sp"
            android:textColor="#444"/>

        <!-- Address -->
        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address: Near Market, Ward 12"
            android:textSize="14sp"
            android:textColor="#444"/>

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Issue: House tax mismatch in name."
            android:textSize="14sp"
            android:textColor="#444"
            android:layout_marginBottom="10dp"/>



        <!-- Last Update -->
        <TextView
            android:id="@+id/tvLastUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last Updated: 11 Dec 2024 • 10:15 AM"
            android:textSize="12sp"
            android:textColor="#777"
            android:layout_marginTop="8dp"/>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
