<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_with_opacity">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolBar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                style="@style/Widget.MaterialComponents.Toolbar.Surface"
                app:contentInsetStartWithNavigation="0dp">

                <!-- Back Icon -->
                <ImageView
                    android:id="@+id/navBack"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/left_icon"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="start|center_vertical"
                    android:padding="4dp" />

                <!-- Title placed manually -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Details"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="20dp"
                    android:layout_gravity="center_vertical" />

            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ================= HEADER ================= -->
                <TextView
                    android:id="@+id/tvHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PID: 10409800068001"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="16sp"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp" />

                <!-- ================= TAX SUMMARY CARD ================= -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="1dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- ====== SECTION TITLE ====== -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tax Summary"
                            android:textSize="16sp"
                            android:textColor="#1A1A1A"
                            android:paddingBottom="10dp"
                            android:fontFamily="@font/poppins_medium" />

                        <!-- ====== DATA BOX (Rounded White Panel) ====== -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="#F7F9FC"
                            android:padding="14dp"
                            android:layout_marginBottom="16dp"
                            android:backgroundTint="#F7F9FC"
                            android:paddingVertical="10dp">


                            <!-- Arrear -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Bill Date"
                                    android:textColor="#2C3E50"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />

                                <TextView
                                    android:id="@+id/tvBillDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#34495E"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </LinearLayout>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Bill Number"
                                    android:textColor="#2C3E50"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />

                                <TextView
                                    android:id="@+id/tvBillNumber"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#34495E"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Financial Year"
                                    android:textColor="#2C3E50"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />

                                <TextView
                                    android:id="@+id/tvFinancialYear"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#34495E"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </LinearLayout>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Total Arv"
                                    android:textColor="#2C3E50"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />

                                <TextView
                                    android:id="@+id/tvTotalArv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#34495E"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </LinearLayout>

                            <!-- Divider Line -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#E1E6ED"
                                android:layout_marginVertical="3dp" />



                            <!-- House Tax Net Amount -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="House Tax Net Amount"
                                    android:textColor="#2C3E50"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />

                                <TextView
                                    android:id="@+id/tvHouseTaxNetAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#34495E"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </LinearLayout>




                            <!-- Water Tax Net Amount -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Water Tax Net Amount"
                                    android:textColor="#2C3E50"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />

                                <TextView
                                    android:id="@+id/tvWaterTaxNetAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#34495E"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </LinearLayout>



                            <!-- Sewer Tax Net Amount -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Sewer Tax Net Amount"
                                    android:textColor="#2C3E50"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />

                                <TextView
                                    android:id="@+id/tvSewerTaxNetAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#34495E"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </LinearLayout>



                            <!-- other Tax Net Amount -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Other Tax Net Amount"
                                    android:textColor="#2C3E50"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />

                                <TextView
                                    android:id="@+id/tvOtherTaxNetAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#34495E"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </LinearLayout>




                            <!-- water charge Net Amount -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Water Charge Net Amount"
                                    android:textColor="#2C3E50"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />

                                <TextView
                                    android:id="@+id/tvWaterChargeNetAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#34495E"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </LinearLayout>


                            <!--  Net demond -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Net Demand"
                                    android:textColor="#2C3E50"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />

                                <TextView
                                    android:id="@+id/tvNetDemand"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#34495E"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/poppins_regular" />
                            </LinearLayout>




                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Net Payable"
                                    android:textColor="#2C3E50"
                                    android:textSize="16sp"
                                    android:fontFamily="@font/poppins_medium" />

                                <TextView
                                    android:id="@+id/tvNetPayable"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#34495E"
                                    android:textSize="16sp"
                                    android:fontFamily="@font/poppins_medium" />
                            </LinearLayout>


                        </LinearLayout>


                        <!-- ======= MODERN BUTTONS ======= -->

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPayTax"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pay Your Tax Online"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="6dp"
                            app:backgroundTint="@color/primary"
                            android:textColor="@android:color/white"
                            android:textAllCaps="false"
                            android:padding="10dp"
                            android:fontFamily="@font/poppins_medium" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:alignmentMode="alignMargins"
                            android:useDefaultMargins="true"
                            android:rowOrderPreserved="false">

                            <!-- Print Details -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPrintDetails"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:text="Print Property"
                                android:textSize="13sp"
                                android:textColor="@android:color/white"
                                android:textAllCaps="false"
                                android:padding="10dp"
                                app:backgroundTint="@color/primary"
                                android:fontFamily="@font/poppins_medium" />

                            <!-- Add Grievance -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddGrievance"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:text="Add Grievance"
                                android:textSize="13sp"
                                android:textColor="@android:color/white"
                                android:textAllCaps="false"
                                android:padding="10dp"
                                app:backgroundTint="@color/primary"
                                android:fontFamily="@font/poppins_medium" />

                            <!-- ARV History -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnArvHistory"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:text="ARV History"
                                android:textSize="13sp"
                                android:textColor="@android:color/white"
                                android:textAllCaps="false"
                                android:padding="10dp"
                                app:backgroundTint="@color/primary"
                                android:fontFamily="@font/poppins_medium" />

                            <!-- Payment History -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPaymentHistory"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:text="Payment History"
                                android:textSize="13sp"
                                android:textColor="@android:color/white"
                                android:textAllCaps="false"
                                android:padding="10dp"
                                app:backgroundTint="@color/primary"
                                android:fontFamily="@font/poppins_medium" />

                        </GridLayout>


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:padding="10dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- HEADER WITH TOGGLE -->
                        <LinearLayout
                            android:id="@+id/layoutHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="15dp">

                            <TextView
                                android:id="@+id/tvHeaderTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Property Details"
                                android:textSize="16sp"
                                android:fontFamily="@font/poppins_medium"/>

                            <ImageView
                                android:id="@+id/imgArrow"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="#333" />
                    </LinearLayout>

                    <!-- DIVIDER -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E1E6ED" />

                    <!-- DETAILS SECTION (TOGGLE AREA) -->
                    <LinearLayout
                        android:id="@+id/layoutDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:visibility="gone">

                        <!-- PROPERTY ID -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Property/House Id"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>

                            <TextView
                                android:id="@+id/tvPropertyId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="104007700642001"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>
                        </LinearLayout>

                        <!-- Reference No -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Reference No."
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>

                            <TextView
                                android:id="@+id/tvRefNo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KNN50000021211"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>
                        </LinearLayout>

                        <!-- Assessment Date -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Assessment Date"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>

                            <TextView
                                android:id="@+id/tvAssessmentDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="01-04-2008"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>
                        </LinearLayout>

                        <!-- Zone No -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Zone Name"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>

                            <TextView
                                android:id="@+id/tvZone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>
                        </LinearLayout>

                        <!-- Ward Name -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Ward Name"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>

                            <TextView
                                android:id="@+id/tvWardName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="40, ANWAR GANJ"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>
                        </LinearLayout>

                        <!-- Mohalla -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Mohalla Name"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>

                            <TextView
                                android:id="@+id/tvMohalla"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="COOLIE BAZAR"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>
                        </LinearLayout>

                        <!-- Ownership Type -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="propertyType"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>

                            <TextView
                                android:id="@+id/tvOwnershipType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Residential"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>
                        </LinearLayout>

                        <!-- Owner Name -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Owner/Occupier Name"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>

                            <TextView
                                android:id="@+id/tvOwnerName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HAJI ABDUL GAFOOR"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>
                        </LinearLayout>

                        <!-- House No -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="House No."
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>

                            <TextView
                                android:id="@+id/tvHouseNo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="82"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>
                        </LinearLayout>

                        <!-- Address -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Property Address"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_medium"/>

                            <TextView
                                android:id="@+id/tvAddress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
